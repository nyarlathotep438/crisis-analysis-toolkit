   "outputs": [],
   "source": [
    "def zscore_anomaly(df, col, threshold=3):\n",
    "    mean = df[col].mean()\n",
    "    std = df[col].std()\n",
    "    return df[(df[col] - mean).abs() > threshold * std]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "f35220d1-5dc1-4223-bdc7-7a41d166904b",
   "metadata": {},
   "outputs": [],
   "source": [
    "df[\"rolling_mean\"] = df[col].rolling(10).mean()\n",
    "df[\"rolling_std\"] = df[col].rolling(10).std()"
   ]
  }
 ],
