   "source": [
    "import matplotlib.pyplot as plt\n",
    "\n",
    "def plot_timeseries(df, col, time_col=\"timestamp\"):\n",
    "    plt.figure(figsize=(12,4))\n",
    "    plt.plot(df[time_col], df[col])\n",
    "    plt.title(f\"{col} over time\")\n",
    "    plt.xticks(rotation=45)\n",
    "    plt.show()"
   ]
  }
